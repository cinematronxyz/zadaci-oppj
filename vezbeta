#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int *niz;
    int velicina;
    int kapacitet;
} DinamickiNiz;

// inicijalizacija
void inicijalizuj(DinamickiNiz *dn) {
    dn->kapacitet = 10;
    dn->velicina = 0;
    dn->niz = (int*)malloc(dn->kapacitet * sizeof(int));
}

// prosirenje niza
void prosiri(DinamickiNiz *dn) {
    dn->kapacitet *= 2;
    dn->niz = (int*)realloc(dn->niz, dn->kapacitet * sizeof(int));
}

// dodavanje na kraj
void dodajNaKraj(DinamickiNiz *dn, int vrednost) {
    if (dn->velicina == dn->kapacitet) {
        prosiri(dn);
    }
    dn->niz[dn->velicina++] = vrednost;
}

// dodavanje na indeks
void dodajNaIndeks(DinamickiNiz *dn, int indeks, int vrednost) {
    if (indeks < 0 || indeks > dn->velicina) {
        printf("Nevalidan indeks\n");
        return;
    }

    if (dn->velicina == dn->kapacitet) {
        prosiri(dn);
    }

    for (int i = dn->velicina; i > indeks; i--) {
        dn->niz[i] = dn->niz[i - 1];
    }

    dn->niz[indeks] = vrednost;
    dn->velicina++;
}

// brisanje elementa
void obrisiNaIndeksu(DinamickiNiz *dn, int indeks) {
    if (indeks < 0 || indeks >= dn->velicina) {
        printf("Nevalidan indeks\n");
        return;
    }

    for (int i = indeks; i < dn->velicina - 1; i++) {
        dn->niz[i] = dn->niz[i + 1];
    }

    dn->velicina--;
}

// ispis svih elemenata
void ispisiSve(DinamickiNiz *dn) {
    for (int i = 0; i < dn->velicina; i++) {
        printf("%d ", dn->niz[i]);
    }
    printf("\n");
}

// ispis elementa na indeksu
void ispisiNaIndeksu(DinamickiNiz *dn, int indeks) {
    if (indeks < 0 || indeks >= dn->velicina) {
        printf("Nevalidan indeks\n");
        return;
    }
    printf("%d\n", dn->niz[indeks]);
}

// oslobadjanje memorije
void oslobodi(DinamickiNiz *dn) {
    free(dn->niz);
}

int main() {
    DinamickiNiz dn;
    inicijalizuj(&dn);

    dodajNaKraj(&dn, 10);
    dodajNaKraj(&dn, 20);
    dodajNaKraj(&dn, 30);

    ispisiSve(&dn);

    dodajNaIndeks(&dn, 1, 15);
    ispisiSve(&dn);

    obrisiNaIndeksu(&dn, 2);
    ispisiSve(&dn);

    ispisiNaIndeksu(&dn, 1);

    oslobodi(&dn);
    return 0;
}